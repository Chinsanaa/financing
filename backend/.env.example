# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Environment
ENVIRONMENT=development

# Optional: enables the LLM fallback classification tier (rows no rule or
# trained model can place). Free tier — get a key at https://console.groq.com.
# Leave unset to skip this tier entirely.
GROQ_API_KEY=
